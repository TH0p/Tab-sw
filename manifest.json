{
  "manifest_version": 2,
  "name": "Tab Key - Trocar Aba (Zen Browser)",
  "version": "1.0.0",
  "description": "Pressione TAB para ir para a próxima aba aberta no navegador.",
  "permissions": [
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-key-switch@zen-browser",
      "strict_min_version": "57.0"
    }
  }
}