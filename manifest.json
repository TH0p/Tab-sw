{
  "manifest_version": 2,
  "name": "Tab Switch on Tab",
  "version": "1.0.0",
  "description": "Pressione Tab para trocar para a próxima aba do navegador",
  "permissions": ["tabs", "<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
